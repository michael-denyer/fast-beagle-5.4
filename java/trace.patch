+                + '\t' + ix.nMarkers() + '\t' + ix.nTargMarkers() + '\t' + ix.overlapEnd() + '\t'
+                + ix.overlapStart() + '\t' + ix.prevSplice() + '\t' + ix.nextSplice() + '\t'
