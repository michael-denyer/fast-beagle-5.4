+            int majorAllele = -1;
+            for (int j = 0; j < hapIndices.length; ++j) {
+                SynchedIntList list = rareCarriers.get(alStart + j);
+                if (list != null) {
+                    hapIndices[j] = list.toArray();
+                    Arrays.sort(hapIndices[j]);
+                } else {
+                    majorAllele = j;
+                }
+            }
+            if (majorAllele == -1) {
+                setMajorAlleleToNull(hapIndices);
+            }
+            sb.setLength(0);
+            sb.append("m\t").append(m);
+            for (int j = 0; j < hapIndices.length; ++j) {
+                sb.append('\t');
+                if (hapIndices[j] == null) {
+                    sb.append('M');
+                    continue;
+                }
+                for (int k = 0; k < hapIndices[j].length; ++k) {
+                    if (k > 0) sb.append(',');
+                    sb.append(hapIndices[j][k]);
+                }
+            }
