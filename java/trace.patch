+    /** A T3b or T3b1 sample line: the sample index, the allele per stage-1
+     * marker on each haplotype, the cluster sizes, then the unphased and the
+     * missing marker indices ('-' for none). */
+    private static void samples(String seam, phase.PhaseData pd) {
+        StringBuilder sb = new StringBuilder();
+        phase.EstPhase est = pd.estPhase();
+        int nMarkers = est.fpd().stage1TargGT().nMarkers();
+        for (int s = 0, n = est.fpd().stage1TargGT().nSamples(); s < n; ++s) {
+            phase.SamplePhase sp = est.get(s);
+            sb.setLength(0);
+            sb.append("sample\t").append(s).append('\t');
+            for (int m = 0; m < nMarkers; ++m) sb.append(sp.allele1(m)).append(m + 1 < nMarkers ? ',' : '\t');
+            for (int m = 0; m < nMarkers; ++m) sb.append(sp.allele2(m)).append(m + 1 < nMarkers ? ',' : '\t');
+            int[] ends = sp.clustEnds();
+            for (int c = 0; c < ends.length; ++c) {
+                if (c > 0) sb.append(',');
+                sb.append(ends[c] - (c == 0 ? 0 : ends[c - 1]));
+            }
+            sb.append('\t').append(intsOrDash(sp.unphased())).append('\t').append(intsOrDash(sp.missing()));
+            line(seam, sb.toString());
+        }
+    }
