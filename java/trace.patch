+        }
+        line(seam, sb.toString());
+        sb.setLength(0);
+        sb.append("markers\t");
+        int[] used = markers.markers(0, markers.nMarkers());
+        for (int j = 0; j < used.length; ++j) {
+            if (j > 0) sb.append(',');
+            sb.append(used[j]);
+        }
+        line(seam, sb.toString());
