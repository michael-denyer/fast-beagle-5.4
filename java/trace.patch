+/**
+ * Trace dumps for comparing the C port with this Java source. Enabled by
+ * {@code -Dbeagle.trace=<dir>}; each seam writes {@code <dir>/<seam>.txt}.
+ * Not part of Beagle: added by fast-beagle's java/trace.patch.
+ */
+public final class Trace {
+
+    private static final String DIR = System.getProperty("beagle.trace");
+    private static final Map<String, PrintWriter> WRITERS = new HashMap<>();
+
+    static {
+        if (DIR != null) {
+            Runtime.getRuntime().addShutdownHook(new Thread(Trace::closeAll));
+        }
+    }
+
+    private Trace() {
+    }
+
+    public static boolean on() {
+        return DIR != null;
+    }
+
+    public static synchronized void line(String seam, String line) {
+        PrintWriter out = WRITERS.computeIfAbsent(seam, s -> {
+            try {
+                return new PrintWriter(new BufferedWriter(new FileWriter(DIR + "/" + s + ".txt")));
+            } catch (IOException e) {
+                throw new UncheckedIOException(e);
+            }
+        });
+        out.print(line);
+        out.print('\n');
+    }
+
+    /** T1a: one input record's marker as the iterator returned it: CHROM,
+     * POS, the stored IDs joined by ';' ('.' for none), REF, the ALT alleles
+     * joined by ',' ('.' for none), the allele count and the INFO END value
+     * as an int (empty for none). Beagle 5.4 prints ID and ALT this way. */
+    public static void marker(String seam, Marker m) {
+        StringBuilder sb = new StringBuilder();
+        sb.append(m.chrom()).append('\t').append(m.pos()).append('\t');
+        if (m.nIds() == 0) sb.append('.');
+        for (int j = 0, n = m.nIds(); j < n; ++j) {
+            if (j > 0) sb.append(';');
+            sb.append(m.id(j));
+        }
+        sb.append('\t').append(m.allele(0)).append('\t');
+        if (m.nAlleles() == 1) sb.append('.');
+        for (int j = 1, n = m.nAlleles(); j < n; ++j) {
+            if (j > 1) sb.append(',');
+            sb.append(m.allele(j));
+        }
+        sb.append('\t').append(m.nAlleles()).append('\t').append(m.end() == -1 ? "" : String.valueOf(m.end()));
+        line(seam, sb.toString());
+    }
+
+    /** T1b: the samples of an input file, after excludesamples=. */
+    public static void samples(String seam, vcf.Samples samples) {
+        for (int s = 0, n = samples.size(); s < n; ++s) {
+            line(seam, samples.id(s) + '\t' + (samples.isDiploid(s) ? "diploid" : "haploid"));
+        }
+    }
+
+    /** T1c: a target record's class, phase flag and allele per haplotype ('.' for missing). */
+    public static void gtRec(String seam, vcf.GTRec rec) {
+        StringBuilder sb = new StringBuilder();
+        sb.append(rec.getClass().getSimpleName()).append('\t').append(rec.isPhased()).append('\t');
+        for (int h = 0, n = rec.size(); h < n; ++h) {
+            int a = rec.get(h);
+            if (h > 0) sb.append(',');
+            sb.append(a < 0 ? "." : String.valueOf(a));
+        }
+        line(seam, sb.toString());
+    }
+
+    private static final java.util.IdentityHashMap<Object, Integer> GROUPS = new java.util.IdentityHashMap<>();
+
+    /** T1d: a reference record's class, major allele and allele per haplotype. A
+     * SeqCodedRefGTRec also names its sequence group, the shared hapToSeq object, whose
+     * contents are written once as a "group" line when first seen. */
+    public static synchronized void refRec(String seam, vcf.RefGTRec rec) {
+        String group = "-";
+        String seqToAllele = "-";
+        if (rec instanceof vcf.SeqCodedRefGTRec) {
+            ints.IntArray hapToSeq = rec.map(0);
+            Integer id = GROUPS.get(hapToSeq);
+            if (id == null) {
+                id = GROUPS.size();
+                GROUPS.put(hapToSeq, id);
+                line(seam, "group\t" + id + '\t' + ints(hapToSeq));
+            }
+            group = id.toString();
+            seqToAllele = ints(rec.map(1));
+        }
+        StringBuilder sb = new StringBuilder("rec\t");
+        sb.append(rec.getClass().getSimpleName()).append('\t').append(rec.majorAllele()).append('\t')
+                .append(group).append('\t').append(seqToAllele).append('\t');
+        for (int h = 0, n = rec.size(); h < n; ++h) {
+            if (h > 0) sb.append(',');
+            sb.append(rec.get(h));
+        }
+        line(seam, sb.toString());
+    }
