+    /** T3a: a window's stage-1 minor allele frequencies (raw bits), the IBS2
+     * markers and step starts, and each target sample's final IBS2 segments as
+     * otherSample:start-inclEnd. */
+    public static void ibs2(String seam, blbutil.FloatArray maf, phase.Ibs2Markers markers,
